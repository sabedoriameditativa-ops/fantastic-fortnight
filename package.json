{
  "name": "frota-estelar",
  "version": "0.2.0-preview.2",
  "description": "Frota Estelar — jogo de estratégia espacial com batalhas automáticas (single-player e multiplayer)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.js",
    "play": "node server/index.js --open",
    "setup": "npm install --omit=dev --no-audit --no-fund",
    "test": "node --test \"test/**/*.test.js\"",
    "simulate": "node tools/simulate.js",
    "e2e": "node test-e2e/run.js",
    "e2e:ui": "node test-e2e/ui-regressions.js",
    "e2e:features": "node test-e2e/features.js",
    "build:windows": "node tools/build-windows.js",
    "build:web": "node tools/build-web.js",
    "e2e:static": "node test-e2e/static-site.js"
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "es-module-lexer": "3.0.3",
    "fflate": "0.8.2",
    "playwright": "1.56.1"
  }
}
